PL.disposeListeners = function() {
    if (_pGlob) {
        _pGlob.eventListeners.forEach(({ target, type, listener, optionsOrUseCapture }) => {
            target.removeEventListener(type, listener, optionsOrUseCapture);
        });
        _pGlob.eventListeners.length = 0;
    }
}

PL.disposeHTMLElements = function() {
    if (_pGlob) {
        _pGlob.htmlElements.forEach(elem => {
            elem.remove();
        });
        _pGlob.htmlElements.clear();
    }
}

PL.disposeMaterialsCache = function() {
    if (_pGlob) {
        for (const mat of _pGlob.materialsCache.values()) {
            mat.dispose();
        }
        _pGlob.materialsCache.clear();
    }
}

PL.dispose = function() {
    PL.disposeListeners();
    PL.disposeHTMLElements();
    PL.disposeMaterialsCache();
    _pGlob = null;
    // backward compatibility
    if (v3d[Symbol.toStringTag] !== 'Module') {
        delete v3d.PL;
        delete v3d.puzzles;
    }
}

PL.loadPhysics = function() {
    return new Promise(function(resolve, reject) {
        if (!window.Ammo) {
            // COMPAT: < 4.2.0, new puzzles, old engine
            const ammoURL = v3d.findModulePath ? v3d.findModulePath('ammo.wasm.js') :
                    new URL('ammo.wasm.js', document.baseURI).href;

            import(ammoURL).then(mod => {
                let AmmoInit = mod.default;
                // COMPAT: < 4.2.0, new puzzles, old ammo
                if (AmmoInit) {
                    // COMPAT: < 4.4.0, old non-async ammo module
                    if (AmmoInit.constructor.name == 'AsyncFunction') {
                        AmmoInit().then(Ammo => {
                            window.Ammo = Ammo;
                            resolve(Ammo);
                        }).catch(e => {
                            console.error('Failed to fetch ammo.wasm.wasm module', e);
                            resolve();
                        });
                    } else {
                        new AmmoInit().then(Ammo => {
                            window.Ammo = Ammo;
                            resolve(Ammo);
                        }).catch(e => {
                            console.error('Failed to fetch ammo.wasm.wasm module', e);
                            resolve();
                        });
                    }
                } else {
                    // COMPAT: < 4.2.0, old non-modularized ammo.js
                    // which is not connected to html (rare case)
                    resolve();
                }
            }).catch(e => {
                console.error('Failed to fetch ammo.wasm.js/ammo.wasm.wasm modules', e);
                resolve();
            });
        } else {
            resolve(window.Ammo);
        }
    });
}


